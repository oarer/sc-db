      "text": {
        "type": "translation",
        "key": "item.exp.sermistor_mine.description",
        "args": {},
        "lines": {
          "ru": "Опытный боеприпас для автоматического гранатомета, созданный для постановки минных полей. Этот снаряжен миной ПОМ-2.",
          "en": "Experimental ammunition for an automatic grenade launcher, designed for laying minefields. This one is equipped with a POM-2 mine.",
          "es": "Munición experimental para un lanzagranadas automático. Diseñada para sembrar campos de minas. Tiene una mina POM-2 equipada.",
          "fr": "Munitions expérimentales pour lance-grenades automatique, conçues pour la pose de champs de mines. Celui-ci est équipé d'une mine POM-2.",
          "ko": "자동 유탄 발사기에 사용하기 위해 실험 삼아 제작된 탄약으로, 지뢰밭을 만들기 위해 사용된다. POM-2 지뢰가 장전되어 있다."
        }
